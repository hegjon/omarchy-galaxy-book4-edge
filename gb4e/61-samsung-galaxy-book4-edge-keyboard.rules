# Samsung Galaxy Book4 Edge 14: the built-in keyboard's HID descriptor gives it
# BTN_0-range buttons and ABS_VOLUME, so input_id also tags it as a tablet pad.
# libinput then opens it as a tablet pad instead of a keyboard and no keys
# reach the compositor (the kernel console still works). libinput also reads
# the tags of the parent input node, so clear them there too.
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="input*|event*", ATTRS{name}=="hid-over-i2c 0CF2:9050 Keyboard", ENV{ID_INPUT_TABLET}="", ENV{ID_INPUT_TABLET_PAD}=""
