+/*
+ * The mode tables are written for a 19.2 MHz input clock. Modules with a
+ * 26 MHz oscillator keep the 19.2 MHz MIPI clock limits by running the MIPI
+ * PLL at 26 / 6 * 369 MHz (333.125 MHz link) and leave the system PLL at its
+ * 0x140 default, as the Windows driver for the Samsung Galaxy Book4 Edge does.
+ */
+static const struct reg_sequence ov02c10_26mhz_2lane_pll[] = {
+	{0x0303, 0x06},
+	{0x0304, 0x01},
+	{0x0305, 0x71},
+	{0x0316, 0x40},
+	{0x4837, 0x14},
+};
+
+struct ov02c10_clk_cfg {
+	u32 mclk;
+	s64 link_freq;
+	/* 0: derived from the link frequency */
+	u64 pixel_rate;
+	const struct reg_sequence *pll;
+	unsigned int pll_length;
+	/* PLL settings only exist for this many lanes, 0 for any */
+	u8 lanes;
+};
+
+static const struct ov02c10_clk_cfg ov02c10_clk_cfgs[] = {
+	{
+		.mclk = 19200000,
+		.link_freq = OV02C10_LINK_FREQ_400MHZ,
+	},
+	{
+		.mclk = 26000000,
+		.link_freq = OV02C10_LINK_FREQ_333MHZ,
+		.pixel_rate = 173333333,
+		.pll = ov02c10_26mhz_2lane_pll,
+		.pll_length = ARRAY_SIZE(ov02c10_26mhz_2lane_pll),
+		.lanes = 2,
+	},
 };
 
