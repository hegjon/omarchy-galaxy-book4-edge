#!/bin/bash
# The WCN7850 Bluetooth controller comes up unconfigured: its NVM has no
# address and Windows supplies one, so Linux has none. Give it a stable
# locally administered address derived from the machine id.
# Usage: samsung-galaxy-book4-edge-bdaddr hciN
set -u
hci=${1:-hci0}
idx=${hci#hci}
id=$(sha256sum /etc/machine-id | cut -c1-10)
addr="02:${id:0:2}:${id:2:2}:${id:4:2}:${id:6:2}:${id:8:2}"
# The firmware download finishes a few seconds after the device appears.
for _ in $(seq 60); do
  # "btmgmt config" lists unconfigured controllers, "btmgmt info" the rest.
  if btmgmt config 2>/dev/null | grep -A3 "^$hci:" |
     grep -q "missing options: .*public-address"; then
    exec btmgmt --index "$idx" public-addr "$addr"
  fi
  btmgmt info 2>/dev/null | grep -q "^$hci:.*Primary controller" && exit 0
  sleep 0.5
done
echo "$hci: never showed up unconfigured; address not set" >&2
exit 1
